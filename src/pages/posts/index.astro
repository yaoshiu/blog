---
import Base from '@layouts/Base.astro';
import SlideIn from '@components/SlideIn.astro';
import { getCollection, render } from 'astro:content';
import DayJS from '@components/solid/DayJS';
import { postSlug } from '@lib/posts';

const posts = (await Promise.all(
  (await getCollection('posts')).map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return {
      ...post,
      slug: postSlug(post),
      readingTime: remarkPluginFrontmatter.readingTime,
    };
  }),
)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<Base title="Posts" description="Posts of Fay Ash" image="/og.png">
  <div class="prose dark:prose-invert text-sm sm:text-base">
    <SlideIn>
      <h1>Posts</h1>
      <ol class="not-prose">
        {
          posts.map((post) => (
            <li class="py-2">
              <a
                href={`/posts/${post.slug}`}
                class="sm:text-lg opacity-80 hover:opacity-100 transition-opacity"
              >
                <div class="sm:inline-block">{post.data.title}</div>
                <span class="sm:ml-2 text-sm md:text-xs text-text-1">
                  {post.readingTime} ·
                  <time datetime={post.data.published.toISOString()}>
                    <DayJS
                      date={post.data.published}
                      format="MMM D, YYYY"
                      client:visible
                    />
                  </time>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </SlideIn>
  </div>
</Base>
