---
import Base from '@layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { postSlug } from '@lib/posts';

const posts = (await Promise.all(
  (await getCollection('posts')).map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);
    return {
      ...post,
      slug: postSlug(post),
      readingTime: remarkPluginFrontmatter.readingTime,
    };
  }),
)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<script>
  import '@components/slide-in';
  import '@components/local-time';
</script>

<Base title="Posts" description="Posts of Fay Ash" image="/og.png">
  <div class="prose dark:prose-invert text-sm sm:text-base">
    <slide-in>
      <h1>Posts</h1>
      <ol class="not-prose">
        {
          posts.map((post) => (
            <li class="py-2">
              <a
                href={`/posts/${post.slug}`}
                class="opacity-80 transition-opacity hover:opacity-100 sm:text-lg"
              >
                <div class="sm:inline-block">{post.data.title}</div>
                <span class="text-text-1 text-sm sm:ml-2 md:text-xs">
                  {post.readingTime} ·
                  <time datetime={post.data.published.toISOString()}>
                    <local-time date={post.data.published} format="MMM D, YYYY" guess />
                  </time>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </slide-in>
  </div>
</Base>
