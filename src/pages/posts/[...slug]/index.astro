---
import { getCollection, render } from 'astro:content';
import DayJS from '@components/solid/DayJS';
import Base from '@layouts/Base.astro';
import SlideIn from '@components/SlideIn.astro';
import Lightbox from '@components/Lightbox.astro';
import postData from '@lib/postData';
import { postSlug } from '@lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => ({
    params: { slug: postSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { slug } = Astro.params;

const { Content, remarkPluginFrontmatter } = await render(entry);
const lastModified = remarkPluginFrontmatter.lastModified || entry.data.published;

const data = await postData({ entry, site: Astro.site });
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  image={`/posts/${slug}/og.png`}
  {data}
>
  <div class="prose dark:prose-invert">
    <div class="flex gap-4 items-center">
      <h1>{entry.data.title}</h1>
      <div class="not-prose p-2 border-l-4 border-text-1/30 text-sm text-text-1">
        <p>
          {remarkPluginFrontmatter.readingTime} ·
          <DayJS
            date={entry.data.published}
            format="MMM D, YYYY"
            client:visible
          />
        </p>
        <p>
          Last modified
          <DayJS
            date={lastModified}
            format="HH:mm, MMM D, YYYY"
            client:visible
          />
        </p>
      </div>
    </div>
    <SlideIn>
      <Lightbox>
        <Content />
      </Lightbox>
    </SlideIn>
  </div>
</Base>
